* text=auto eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Preserve the retained diagnostic export byte for byte.
reproduction/supporting/diagnostics/known-offset-diagnostic.csv -text whitespace=cr-at-eol

# Preserve recorded paper-table bytes and provenance hashes across Git checkouts.
reproduction/aggregate-data/*.csv -text whitespace=cr-at-eol

# Keep the pinned third-party source byte-identical, including its blank line.
reproduction/upstream/disco.py whitespace=-blank-at-eol
