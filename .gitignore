# Deny by default: every root path is private unless explicitly reopened below.
/*

# Repository metadata and public check runner.
!/.gitattributes
!/.gitignore
!/CITATION.cff
!/LICENSE
!/LICENSE-RESULTS
!/README.md
!/THIRD_PARTY_DATA.md
!/pytest.ini
!/requirements.txt
!/requirements-figures.txt
!/run_public_checks.sh

# Exact public CI entry point; all other GitHub metadata stays private by default.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/public-checks.yml

# Portable authored source modules.
!/src/
/src/*
